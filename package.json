{
  "name": "tanstack_start_ts",
  "version": "1.0.13",
  "description": "מערכת שולחנית מקומית לבניית והרצת אוטומציות מבא״ת",
  "author": "Tanenbaum Architects",
  "private": true,
  "workspaces": [
    "browser-extension"
  ],
  "main": "electron/main.cjs",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "extension:dev": "npm --workspace mavat-recorder-extension run dev",
    "extension:build": "npm --workspace mavat-recorder-extension run build",
    "extension:zip": "npm --workspace mavat-recorder-extension run zip",
    "test:extension-sidepanel": "node tools/test_extension_sidepanel.cjs",
    "test:floating-recording": "node tools/test_floating_recording_control.cjs",
    "test:electron-stability": "node tools/test_electron_stability.cjs",
    "test:electron-runtime": "node tools/test_electron_runtime_stability.cjs",
    "qa:source": "npm run test:electron-stability && python tools/test_architecture.py && python -m unittest discover -s tests -v && npm run build:electron-ui && npm run extension:build",
    "qa:release": "npm run qa:source && npm run build:python-backend && electron-builder --win dir && npm run test:electron-runtime",
    "build:electron-ui": "vite build --config vite.electron.config.ts",
    "build:python-backend": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build_python_backend.ps1",
    "dist:win": "npm run qa:release && electron-builder --win nsis",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "playwright": "^1.58.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/router-plugin": "1.168.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.6.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2",
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "^2.10.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-builder@26.0.12": true
  }
}
